{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutdeck",
  "version": "0.1.0",
  "identifier": "app.cutdeck.editor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cutdeck",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi", "dmg", "app"],
    "category": "Video",
    "shortDescription": "Desktop video editor",
    "longDescription": "Cutdeck is a desktop video editor with a timeline, 0.25x to 100x speed, on-device auto captions, video stabilization, filters, text, music, AI background removal and GPU-accelerated MP4 export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cutdeck-ffmpeg",
      "binaries/cutdeck-ffprobe"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "resources/models/*": "models/",
      "resources/onnxruntime/*": "onnxruntime/",
      "resources/whisper/*": "whisper/"
    }
  }
}